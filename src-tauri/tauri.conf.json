{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moneyshot",
  "version": "0.1.0",
  "identifier": "cool.testy.mark",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Moneyshot",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#f3f2ee",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../assets/icon-256.png"]
  }
}
